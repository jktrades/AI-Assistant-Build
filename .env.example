# ─── Supabase ──────────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── LLM providers ─────────────────────────────────────────────────────────
# console.anthropic.com  — primary (writing quality + structured output)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# platform.openai.com    — Whisper transcription, embeddings, fallback classifier
OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── Auth gate ─────────────────────────────────────────────────────────────
# openssl rand -hex 32
AUTH_SECRET=
DASHBOARD_PASSWORD=
# openssl rand -hex 32 — programmatic access (CLI / cron / Telegram → /api/capture)
API_SECRET=

# ─── Telegram capture ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USER_ID=

# ─── Calendar (Google Calendar secret iCal URL) ────────────────────────────
GOOGLE_CALENDAR_ICAL_URL=

# ─── Finance (Google service account, private sheet) ───────────────────────
GOOGLE_SHEETS_FINANCE_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key field from the JSON key. Keep the literal \n escapes.
GOOGLE_SERVICE_ACCOUNT_KEY=

# ─── Vercel cron ───────────────────────────────────────────────────────────
# openssl rand -hex 32
CRON_SECRET=

# ─── Personalisation ───────────────────────────────────────────────────────
USER_TIMEZONE=Europe/Madrid
USER_ID=me
